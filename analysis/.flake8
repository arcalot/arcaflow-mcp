[flake8]
# Match Black's line length
max-line-length = 88

# Exclude directories
exclude =
    .git,
    __pycache__,
    .venv,
    .pytest_cache,
    *.egg-info,
    build,
    dist

# Ignore E203 (whitespace before ':') which conflicts with Black
# Ignore W503 (line break before binary operator) which is outdated
extend-ignore = E203, W503
