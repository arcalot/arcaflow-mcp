# Arcaflow MCP Container Environment Variables
#
# Copy this file to .env and customize as needed:
#   cp .env.example .env
#
# Then run: docker compose up -d

# REQUIRED: Admin authentication token for MCP server
# Generate with: openssl rand -base64 32
ARCAFLOW_MCP_ADMIN_TOKEN=changeme

# OPTIONAL: Container image tag
# 
# PRE-RELEASE (before v0.1.0): Get current development tag:
#   export TAG=$(curl -s https://raw.githubusercontent.com/arcalot/arcaflow-mcp/main/scripts/get-container-tag.sh | bash)
#
# POST-RELEASE (after v0.1.0): Use latest or version tags:
#   TAG=latest        # Latest stable build
#   TAG=v1.0.0        # Specific release version
#
# Leave commented to use 'latest' (default after v0.1.0)
#TAG=main-abc1234

# OPTIONAL: Container registry
# Default: quay.io/arcalot
#IMAGE_REPO=quay.io/arcalot

# OPTIONAL: Logging level
# Options: DEBUG, INFO (default), WARNING, ERROR
#LOG_LEVEL=INFO

# OPTIONAL: Local workflow directory to mount
# Create directory first: mkdir -p ./workflows
#WORKFLOW_DIR=./workflows
