# Arcaflow MCP Container Environment Variables
#
# Copy this file to .env and customize as needed:
#   cp .env.example .env
#
# Then run: docker compose up -d

# REQUIRED: Admin authentication token for MCP server
# Generate with: openssl rand -base64 32
ARCAFLOW_MCP_ADMIN_TOKEN=changeme

# OPTIONAL: Container image tag
# Options: latest (default), v1.0.0 (release), main-abc1234 (development)
#TAG=latest

# OPTIONAL: Container registry
# Default: quay.io/arcalot
#IMAGE_REPO=quay.io/arcalot

# OPTIONAL: Logging level
# Options: DEBUG, INFO (default), WARNING, ERROR
#LOG_LEVEL=INFO

# OPTIONAL: Local workflow directory to mount
# Create directory first: mkdir -p ./workflows
#WORKFLOW_DIR=./workflows
